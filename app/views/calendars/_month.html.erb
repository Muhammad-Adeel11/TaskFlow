<div class="calendar-wrap">
  <%= month_calendar(attribute: :start_time, events: entries) do |date, day_entries| %>
    <div class="cal-day-number"><%= date.day %></div>

    <% day_entries.each do |entry| %>
      <%= link_to entry.title, entry.link,
          class: ["cal-task", "is-#{entry.status}", ("is-overdue" if entry.overdue), ("is-team" if entry.source == :team)],
          target: (entry.external ? "_blank" : nil),
          rel: (entry.external ? "noopener" : nil),
          title: entry.tooltip %>
    <% end %>
  <% end %>
</div>